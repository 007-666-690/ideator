# Copia este archivo a .env y completa los valores. Nunca subas .env al repositorio.

ENVIRONMENT=development
LOG_LEVEL=INFO

# Mínimo 32 caracteres. Genera uno con: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=cambia-esto-por-un-secreto-largo-y-aleatorio-0000
COOKIE_SECURE=false

# Modelo de IA: "azure" (GPT-5 del curso), "gemini" (Google) o "fake" (modo demo sin IA)
LLM_PROVIDER=azure
AZURE_OPENAI_ENDPOINT=https://<recurso>.openai.azure.com/openai/v1
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-5
# Con LLM_PROVIDER=gemini se usa Gemini (créditos de Google Cloud). Clave desde aistudio.google.com
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.6-flash
LLM_REASONING_EFFORT=low

# SSO (opcional). Callback a registrar en el proveedor:
#   <BACKEND_PUBLIC_URL>/api/auth/sso/microsoft/callback
#   <BACKEND_PUBLIC_URL>/api/auth/sso/google/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=organizations
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Opcional: leer los secretos desde Azure Key Vault
AZURE_KEY_VAULT_URL=
